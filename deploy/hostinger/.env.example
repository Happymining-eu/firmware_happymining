# Environment for deploy/hostinger/docker-compose.yml (a host that already runs Traefik).
# Every value below is a placeholder. Real values go into the Hostinger Docker
# project's environment, never into version control.

# The commit to build and run (full SHA). A new value rebuilds the image.
HM_GIT_REF=
# HM_GIT_URL=https://github.com/Happymining-eu/firmware_happymining.git

# demo + fake, or live + vast. There is no fallback between modes, and a
# database belongs to the mode that first used it.
HM_MODE=demo
HM_PROVIDER=fake

# Host names Traefik routes here. They must already resolve to this server:
# Traefik requests a certificate for each of them.
HM_PUBLIC_HOST=cloud.happymining.fr
# Optional second name (for agents). Defaults to HM_PUBLIC_HOST.
# HM_API_HOST=api.happymining.fr

# Secrets. Generate your own:
#   HM_SECRET_KEY            python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   HM_FIELD_ENCRYPTION_KEY  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   POSTGRES_PASSWORD        python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   HM_DB_APP_PASSWORD       the same command again; a different value
HM_SECRET_KEY=change-me
HM_FIELD_ENCRYPTION_KEY=change-me
POSTGRES_PASSWORD=change-me
HM_DB_APP_PASSWORD=change-me

# Staging gate: HTTP basic authentication in front of the pages and the
# sign-in endpoints. htpasswd entries, comma-separated. The {SHA} form has no
# "$" to escape; use it only with a long random password:
#   python3 -c "import base64,hashlib,sys; print('staging:{SHA}'+base64.b64encode(hashlib.sha1(sys.argv[1].encode()).digest()).decode())" 'the password'
# Left unset, the gate is locked: nobody can pass it.
HM_BASIC_AUTH_USERS=
# LIVE, where users sign in with a password and MFA: remove the gate.
# HM_GATE_MIDDLEWARES=hmos-limit,hmos-headers

# DEMO only. LIVE refuses to start with any of these.
HM_DEMO_LOGIN_ENABLED=true
HM_PAYOUTS_ENABLED=true
HM_PAYOUT_PROVIDER=mock

# Traefik names on this host.
# HM_TRAEFIK_ENTRYPOINT=websecure
# HM_TRAEFIK_CERTRESOLVER=letsencrypt
# HM_TRUSTED_PROXY_HOPS=1

# LIVE only; see deploy/.env.example for what each one means.
# HM_VAST_API_KEY=
# HM_VAST_COMMERCIAL_AUTHORIZATION_REF=
# HM_VAST_EARNINGS_BASIS=unverified
# HM_VAST_EARNINGS_BUCKETS_VERIFIED=false
# HM_METRICS_TOKEN=
