# HappyMining OS control plane configuration.
# Copy to deploy/.env, fill in, and keep that file out of version control.
# Every value below is a placeholder. LIVE mode refuses to start with them.

# ---------------------------------------------------------------------------
# Mode. There is no default and no fallback between modes.
#   demo  fake machines, synthetic provider fixtures, simulated receipts.
#         No real money, no real hardware actions, never calls Vast.
#   live  real provider adapter, real credentials, read-only by default.
# ---------------------------------------------------------------------------
HM_MODE=demo
# fake (demo only) or vast (live only)
HM_PROVIDER=fake

# ---------------------------------------------------------------------------
# Secrets. Generate your own:
#   HM_SECRET_KEY            python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   HM_FIELD_ENCRYPTION_KEY  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   POSTGRES_PASSWORD        python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   HM_DB_APP_PASSWORD       the same command again; a different value
# Losing HM_FIELD_ENCRYPTION_KEY makes stored beneficiary details and TOTP
# secrets unreadable. Changing HM_SECRET_KEY invalidates every session, every
# device credential and every pending pairing code. Back both up separately
# from the database.
# ---------------------------------------------------------------------------
HM_SECRET_KEY=change-me
HM_FIELD_ENCRYPTION_KEY=change-me
# Owner role: used only by the migration job.
POSTGRES_PASSWORD=change-me
# Runtime role "happymining_app": what the API and the worker connect as.
# Use URL-safe characters (token_urlsafe produces them), at least 12.
HM_DB_APP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Public addresses. The fleet platform is separate from the Shopify shop.
# ---------------------------------------------------------------------------
# What Caddy serves. Host names get automatic HTTPS; ":80" serves plain HTTP.
HM_SITE_ADDRESS=api.happymining.fr, cloud.happymining.fr
HM_ACME_EMAIL=
# The origin browsers use (scheme + host). Must be https:// in LIVE mode.
HM_PUBLIC_BASE_URL=https://cloud.happymining.fr
# Host names the API answers to, comma-separated.
HM_ALLOWED_HOSTS=api.happymining.fr,cloud.happymining.fr
# Extra browser origins allowed to call the API. Empty unless a separate front end exists.
HM_CORS_ALLOWED_ORIGINS=
HM_COOKIE_SECURE=true
HM_HTTP_PORT=80
HM_HTTPS_PORT=443
# Reverse proxies in front of the API that set X-Forwarded-For. 1 = Caddy only.
HM_TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Demo login (DEMO mode only; LIVE refuses to start if this is true).
# With the demo overlay, Caddy also asks for this basic-auth user.
#   HM_BASIC_AUTH_HASH:  docker run --rm caddy:2.10 caddy hash-password --plaintext 'your password'
#   (in a .env file, write every $ of the hash as $$)
# ---------------------------------------------------------------------------
HM_DEMO_LOGIN_ENABLED=false
HM_BASIC_AUTH_USER=
HM_BASIC_AUTH_HASH=

# ---------------------------------------------------------------------------
# Vast.ai (LIVE). See docs/integration-evidence.md for what is and is not verified.
# ---------------------------------------------------------------------------
# A scoped key with machine_read, billing_read and user_read only. Stays on the
# backend; never given to agents or the dashboard.
HM_VAST_API_KEY=
# Reference to the written agreement with Vast that authorises HappyMining to
# operate third-party machines and use the API for it. While empty, the adapter
# refuses to call Vast at all.
HM_VAST_COMMERCIAL_AUTHORIZATION_REF=
# Leave as "unverified" until it is established whether Vast's reported host
# earnings are net of Vast's own fee. Unverified earnings are fetched and kept
# as evidence but never posted to the ledger.
HM_VAST_EARNINGS_BASIS=unverified
# Set to true only after the day unit and range boundaries of the earnings
# endpoint have been verified against real data.
HM_VAST_EARNINGS_BUCKETS_VERIFIED=false
# Provider writes (unlisting). Off by default.
HM_PROVIDER_MUTATIONS_ENABLED=false

# ---------------------------------------------------------------------------
# Operations and money. Everything that can disrupt a renter or move money is
# off by default.
# ---------------------------------------------------------------------------
HM_DISRUPTIVE_OPERATIONS_ENABLED=false
HM_PAYOUTS_ENABLED=false
# manual_export (export a file, pay at the bank, confirm with evidence) or
# mock (demo only). There is no automatic money-transfer integration.
HM_PAYOUT_PROVIDER=manual_export
HM_PAYOUT_MINIMUM=1.00
HM_PAYOUT_REQUIRE_DISTINCT_APPROVER=true

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Bearer token for GET /metrics (reachable only inside the Docker network).
HM_METRICS_TOKEN=
HM_LOG_LEVEL=INFO
HM_BACKUP_DIR=./backups
HM_IMAGE_TAG=local
