# Reverse proxy for the HappyMining OS control plane.
#
# HM_SITE_ADDRESS is one or more site addresses, for example:
#   api.happymining.fr, cloud.happymining.fr     automatic HTTPS (Let's Encrypt)
#   :80                                          plain HTTP, only behind another TLS terminator
# The fleet platform is separate from the Shopify shop; do not point the shop's
# own host names here.
{
	email {$HM_ACME_EMAIL}
	admin off
}

{$HM_SITE_ADDRESS} {
	encode zstd gzip

	# Device heartbeats are capped at 256 KiB by the API; nothing legitimate is
	# larger than 1 MB, except one route: the upload of a firmware package by
	# staff (PUT /api/v1/releases/<version>/artifact). The API authenticates
	# that request before it reads the body and caps it at HM_RELEASE_MAX_BYTES
	# and at the size its signed manifest declares; here it gets 512 MB.
	@release_artifact {
		method PUT
		path_regexp ^/api/v1/releases/[0-9]+\.[0-9]+\.[0-9]+/artifact$
	}
	@not_release_artifact {
		not {
			method PUT
			path_regexp ^/api/v1/releases/[0-9]+\.[0-9]+\.[0-9]+/artifact$
		}
	}
	request_body @release_artifact {
		max_size 512MB
	}
	request_body @not_release_artifact {
		max_size 1MB
	}

	# Metrics are for the internal network only (docker exec / compose network).
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
		health_uri /healthz
		health_interval 15s
	}

	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}
