# DEMO staging: same proxy, with HTTP basic authentication in front of everything.
# The demo login has no passwords, so the demo must not be open to the internet.
{
	email {$HM_ACME_EMAIL}
	admin off
}

{$HM_SITE_ADDRESS} {
	encode zstd gzip

	# Device heartbeats are capped at 256 KiB by the API; nothing legitimate is
	# larger than 1 MB, except one route: the upload of a firmware package by
	# staff (PUT /api/v1/releases/<version>/artifact). The API authenticates
	# that request before it reads the body and caps it at HM_RELEASE_MAX_BYTES
	# and at the size its signed manifest declares; here it gets 512 MB.
	@release_artifact {
		method PUT
		path_regexp ^/api/v1/releases/[0-9]+\.[0-9]+\.[0-9]+/artifact$
	}
	@not_release_artifact {
		not {
			method PUT
			path_regexp ^/api/v1/releases/[0-9]+\.[0-9]+\.[0-9]+/artifact$
		}
	}
	request_body @release_artifact {
		max_size 512MB
	}
	request_body @not_release_artifact {
		max_size 1MB
	}

	@metrics path /metrics
	respond @metrics 404

	# What needs the password: every page, and the passwordless demo login.
	# What does not: liveness, and the JSON API, which has its own
	# authentication (a session token that can only be obtained through the
	# protected demo login, or a device credential obtained by pairing). The
	# API cannot share the Authorization header with basic authentication.
	@pages {
		not path /healthz
		not path /api/v1/*
		not path /static/*
	}
	@demo_login path /api/v1/auth/demo-login /api/v1/auth/login
	basic_auth @pages {
		{$HM_BASIC_AUTH_USER} {$HM_BASIC_AUTH_HASH}
	}
	basic_auth @demo_login {
		{$HM_BASIC_AUTH_USER} {$HM_BASIC_AUTH_HASH}
	}

	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
		health_uri /healthz
		health_interval 15s
	}

	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
	}

	log {
		output stdout
		format json
	}
}
