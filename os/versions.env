# HappyMining OS — pinned versions and policies.
#
# Plain KEY=VALUE shell assignments. This file is sourced by the scripts in os/
# and copied into the install-scripts bundle. Do not put secrets here.
# Every value that comes from a third party cites its source. Access date for
# all sources: 2026-10-02. See os/README.md ("Verified against" / "Unverified").

# ---------------------------------------------------------------------------
# Base release — THE single switch for the Ubuntu base.
# ---------------------------------------------------------------------------
# Source: https://docs.vast.ai/host/verification-stages ("Minimum Requirements
# for Verification" > Operating System):
#   "Operating system | Ubuntu Server 22.04 LTS, 24.04 LTS recommended"
#   "Use a server edition. Desktop editions are not supported."
# Vast's maintenance pages (https://docs.vast.ai/host/upgrade-kernel,
# https://docs.vast.ai/host/upgrade-docker-and-packages) say the steps are
# "the same on Ubuntu Server 22.04 and 24.04".
# => 24.04 LTS is documented and recommended by Vast, so it is the default.
#    22.04 LTS is the only other documented release.
UBUNTU_RELEASE=24.04

# Ubuntu releases the installer accepts on an EXISTING server (install.sh).
SUPPORTED_UBUNTU_VERSIONS="22.04 24.04"

# Point release currently published in ${UBUNTU_RELEASE_URL}/ .
# Source: directory listing https://releases.ubuntu.com/24.04/ read on
# 2026-10-02: "ubuntu-24.04.5-live-server-amd64.iso  2026-09-09 09:12  3.8G".
# releases.ubuntu.com keeps only the newest point release in this directory;
# when Canonical publishes a newer one, build-iso.sh fails with a clear message
# (the pinned file name is no longer in the signed SHA256SUMS) and this value
# must be bumped deliberately.
UBUNTU_POINT_RELEASE=24.04.5
UBUNTU_ARCH=amd64
UBUNTU_ISO_FILENAME="ubuntu-${UBUNTU_POINT_RELEASE}-live-server-${UBUNTU_ARCH}.iso"
UBUNTU_RELEASE_URL="https://releases.ubuntu.com/${UBUNTU_RELEASE}"
UBUNTU_ISO_URL="${UBUNTU_RELEASE_URL}/${UBUNTU_ISO_FILENAME}"
UBUNTU_SUMS_URL="${UBUNTU_RELEASE_URL}/SHA256SUMS"
UBUNTU_SUMS_SIG_URL="${UBUNTU_RELEASE_URL}/SHA256SUMS.gpg"

# NO ISO HASH IS PINNED HERE ON PURPOSE. build-iso.sh downloads SHA256SUMS and
# SHA256SUMS.gpg from the URLs above, verifies the signature against the key
# below, and only then checks the ISO against the signed list.

# "Ubuntu CD Image Automatic Signing Key (2012) <cdimage@ubuntu.com>".
# Source 1: https://ubuntu.com/tutorials/how-to-verify-ubuntu (expected gpg
#   output shows "8439 38DF 228D 22F7 B374 2BC0 D94A A3F0 EFE2 1092").
# Source 2: the same key is shipped in the ubuntu-keyring package as
#   /usr/share/keyrings/ubuntu-archive-keyring.gpg (checked on an Ubuntu 24.04
#   system on 2026-10-02 with
#   `gpg --no-default-keyring --keyring <that file> --list-keys --with-fingerprint`).
UBUNTU_CDIMAGE_KEY_FPR=843938DF228D22F7B3742BC0D94AA3F0EFE21092
# Default keyring used to verify SHA256SUMS.gpg; override with
# build-iso.sh --ubuntu-keyring FILE. The fingerprint above is enforced either way.
UBUNTU_KEYRING_DEFAULT=/usr/share/keyrings/ubuntu-archive-keyring.gpg

# ---------------------------------------------------------------------------
# HappyMining agent package (built by agent/scripts/build-deb.sh).
# ---------------------------------------------------------------------------
AGENT_PACKAGE=happymining-agent
AGENT_VERSION=0.1.0
AGENT_ARCH=amd64
AGENT_DEB_FILENAME="${AGENT_PACKAGE}_${AGENT_VERSION}_${AGENT_ARCH}.deb"

# ---------------------------------------------------------------------------
# NVIDIA driver selection POLICY (nothing in os/ installs a driver).
# ---------------------------------------------------------------------------
# Policy "ubuntu-drivers-gpgpu": use the driver branch that Ubuntu's own
# `ubuntu-drivers` tool lists for this GPU in compute/server mode, from the
# Ubuntu archive, never "the newest" from a PPA or a vendor .run file.
# Source: https://ubuntu.com/server/docs/how-to/graphics/install-nvidia-drivers/
#   - "sudo ubuntu-drivers list --gpgpu" / "sudo ubuntu-drivers install --gpgpu"
#   - "-server" (ERD) branches are "recommended on servers and for computing tasks"
#   - pre-built signed modules (linux-modules-nvidia-<branch>-server-<flavour>)
#     are preferred; DKMS is not recommended "unless you are running a custom
#     kernel for which the prebuilt drivers are not supported".
# Vast's own rule (https://docs.vast.ai/host/verification-stages):
#   "NVIDIA driver | A currently supported release for your GPU",
#   "CUDA version | 11.8 or newer", "Secure Boot | Disabled".
NVIDIA_DRIVER_POLICY=ubuntu-drivers-gpgpu
# Lowest driver that can run CUDA 11.8 (Vast's minimum CUDA).
# Source: https://docs.nvidia.com/cuda/cuda-toolkit-release-notes/index.html
#   "CUDA 11.8 GA | >=520.61.05" (Linux x86_64).
NVIDIA_MIN_DRIVER_VERSION=520.61.05

# ---------------------------------------------------------------------------
# Vast storage requirements used by the unattended seed.
# ---------------------------------------------------------------------------
# Source A: https://docs.vast.ai/host/verification-stages > Storage:
#   "Storage type | SSD", "Dedicated drive for Docker container storage | 200 GB",
#   "Root partition free space | 20 GB".
VAST_MIN_DOCKER_STORAGE_GB=200
VAST_MIN_ROOT_FREE_GB=20
# Source B: the official Vast host installer, https://console.vast.ai/install
#   (redirects to https://s3.amazonaws.com/public.vast.ai/kaalia/scripts/vast_host_installer.py):
#   DOCKER_DIR_NOS = "/var/lib/docker"; fstab line it writes:
#   'UUID="<uuid>" /var/lib/docker xfs rw,auto,pquota 0 0'; it refuses a
#   /var/lib/docker mount that is not xfs or lacks pquota/prjquota, and reuses
#   an existing fstab entry for /var/lib/docker that is xfs with pquota.
#   Read through a text extraction of the script, not a byte-exact local copy.
VAST_DOCKER_DATA_FS=xfs
VAST_DOCKER_DATA_MOUNT=/var/lib/docker
VAST_DOCKER_DATA_MOUNT_OPTIONS=rw,auto,pquota
