#!/bin/sh
# prerm of happymining-agent: stop the agent; on removal also disable the
# units and disarm the update guard (which would otherwise reinstall the
# previous package after the removal). Nothing else on the machine is stopped
# or changed: Docker, the Vast host software, renter workloads, the
# appliance's plugins and NAS mounts are not touched.
set -e

UNITS="happymining-agent.service happymining-helper.socket happymining-firstboot.service"

case "$1" in
    remove | deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            if [ -d /run/systemd/system ]; then
                systemctl stop happymining-agent.service happymining-helper.socket || true
                systemctl stop happymining-update-guard.timer || true
            fi
            # shellcheck disable=SC2086
            systemctl disable $UNITS >/dev/null 2>&1 || true
        fi
        ;;
    upgrade)
        # The new version's postinst starts the agent again. The state
        # directory is not touched. The update guard stays armed: it is what
        # rolls a failed update back.
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl stop happymining-agent.service || true
        fi
        ;;
    failed-upgrade) ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
