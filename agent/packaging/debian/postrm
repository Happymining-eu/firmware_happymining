#!/bin/sh
# postrm of happymining-agent. `remove` keeps the state (credential, spool,
# identity); only `purge` deletes the agent's state directory. The
# happymining system user is left in place: removing system users on purge
# can orphan files elsewhere.
#
# Even `purge` leaves the appliance's data where it is: the helper's keys in
# /var/lib/happymining-helper (without the backup key no archive can be
# restored), the plugins' data in /var/lib/happymining-plugins and
# /srv/happymining, where NAS shares may still be mounted. Deleting those is
# a deliberate act by the machine's administrator.
set -e

ROOT="${DPKG_ROOT:-}"

reload_systemd() {
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
}

case "$1" in
    remove)
        reload_systemd
        ;;
    purge)
        rm -rf "$ROOT/var/lib/happymining"
        rmdir "$ROOT/etc/happymining" 2>/dev/null || true
        reload_systemd
        ;;
    upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
