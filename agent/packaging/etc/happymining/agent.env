# HappyMining agent configuration - /etc/happymining/agent.env
#
# Format: one KEY=VALUE per line. Lines starting with # are comments.
# The parser is strict: an unknown key or a malformed line stops the agent
# with a clear error (see: journalctl -u happymining-agent).
# This file is root-owned on purpose and must never contain a secret: the
# device credential lives in /var/lib/happymining/credential.json and is
# created by `sudo happyminingctl pair`.

# Base URL of the HappyMining API (HTTPS, certificate always verified).
HM_API_URL=https://api.happymining.fr

# Seconds between samples (minimum 15). The API may adjust it at run time.
#HM_HEARTBEAT_INTERVAL_S=60

# State directory. If you change it, also change StateDirectory= and
# ReadWritePaths= in a drop-in for happymining-agent.service.
#HM_STATE_DIR=/var/lib/happymining

# Telemetry buffer used while the API is unreachable (oldest dropped first).
#HM_SPOOL_DIR=/var/lib/happymining/spool
#HM_SPOOL_QUOTA_MIB=64
#HM_MAX_SAMPLE_AGE_H=168

# Extra CA bundle (PEM) trusted in addition to the system roots.
#HM_CA_FILE=/etc/happymining/ca.pem

# Development only: allow plain HTTP to 127.0.0.1, ::1 or localhost.
#HM_ALLOW_INSECURE_LOOPBACK=0

# Operation types the local administrator allows beyond the defaults
# (refresh_inventory, collect_diagnostics, run_preflight, rotate_credential).
# Comma-separated list of: restart_vast_daemon, reboot.
# Each of these ALSO needs its switch in /etc/happymining/helper.conf.
# Leave empty unless you really want HappyMining operators to be able to
# restart the Vast daemon or reboot this machine remotely.
#HM_OPS_ENABLED=

# Extra mount points to report (comma-separated absolute paths).
#HM_EXTRA_MOUNTS=

# File holding the NUMERIC Vast machine id (the number shown in the Vast
# console). Only the SHA-256 of that number is sent, as an untrusted hint, and
# only if the unprivileged agent user can read the file and it contains a
# plain number. This default path is not confirmed by Vast documentation.
# Never point this at vastai_kaalia/machine_id: that file is Vast's host API
# key, and the agent refuses to read it.
#HM_VAST_MACHINE_ID_FILE=/var/lib/vastai_kaalia/machine_num_id

# debug, info, warn or error
#HM_LOG_LEVEL=info
