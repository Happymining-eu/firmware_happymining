[Unit]
Description=HappyMining local web page (status and pairing on the LAN)
Documentation=file:///usr/share/doc/happymining-agent/README.md
After=network-online.target happymining-firstboot.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=happymining
Group=happymining
# Listens on every address, port 8080. To change: systemctl edit happymining-ui
# and override ExecStart with --listen 192.168.1.10:8080 (or 127.0.0.1:8080 to
# keep it off the network).
ExecStart=/usr/bin/happymining-ui --config /etc/happymining/agent.env --listen :8080
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=15
UMask=0077

# --- Sandbox: the same as the agent. The page runs no command on behalf of a
# browser; pairing writes the credential into the state directory, as
# `happyminingctl pair` does, and nothing else is written.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
StateDirectory=happymining
StateDirectoryMode=0750
ReadWritePaths=/var/lib/happymining
# nvidia-smi for the GPU table, as in the agent's unit.
PrivateDevices=no

MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
