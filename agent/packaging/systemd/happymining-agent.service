[Unit]
Description=HappyMining monitoring agent
Documentation=file:///usr/share/doc/happymining-agent/README.md
After=network-online.target happymining-firstboot.service nvidia-persistenced.service
Wants=network-online.target
# Restart limits: at most 5 starts in 5 minutes, then systemd gives up.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=happymining
Group=happymining
ExecStart=/usr/bin/happymining-agent --config /etc/happymining/agent.env
Restart=on-failure
RestartSec=10
# Exit status 78 is a configuration error: restarting cannot fix it.
RestartPreventExitStatus=78
TimeoutStopSec=30
UMask=0077

# --- Sandbox -----------------------------------------------------------
# The agent needs no privilege at all. The two privileged actions (both
# disabled by default) are reached through happymining-helper.socket, not
# through sudo, so NoNewPrivileges can stay on.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
# Other users' processes are invisible in /proc: the agent cannot read
# renter process lists or command lines even by mistake.
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
StateDirectory=happymining
StateDirectoryMode=0750
ReadWritePaths=/var/lib/happymining

# GPU telemetry runs nvidia-smi, which opens /dev/nvidiactl and /dev/nvidia*.
# PrivateDevices=yes would hide them, so it is deliberately not set, and no
# device allow-list is active by default (see README, "Device access").
PrivateDevices=no

# Resource limits
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
